{
  "id": "weather",
  "title": "House Weather",
  "lead": "Weather library, regional location, and site-specific climate data.",
  "route": { "view": "house", "screen": "weather", "containerId": "screen-house-weather" },
  "hot2000": {
    "version": "11.13",
    "desktopScreen": "House Weather",
    "controlCount": 6,
    "controls": [
      { "order": 1, "label": "Weather Library", "controlType": "text" },
      { "order": 2, "label": "Change", "controlType": "button" },
      { "order": 3, "label": "Region", "controlType": "combobox" },
      { "order": 4, "label": "Location", "controlType": "combobox" },
      { "order": 5, "label": "Depth of frostline", "controlType": "text" },
      { "order": 6, "label": "Heating Degree Days from Weather File :", "controlType": "text" }
    ]
  },
  "verification": {
    "status": "unverified",
    "source": ["HOT2000 11.13 House Weather screen inventory", "template.h2k ProgramInformation/Weather"],
    "desktopChecksPending": [
      "Field labels and order on House Weather screen",
      "Change button weather library picker behavior",
      "Region and Location combobox contents per weather library",
      "HDD auto-fill on location change",
      "Depth of frostline units and precision"
    ]
  },
  "migration": {
    "status": "catalog-driven",
    "renderer": "renderWeatherTab"
  },
  "layout": "spec-layout weather-spec-layout",
  "class": "weather-section catalog-section",
  "beforeRender": ["syncWeatherRegionToClient"],
  "groups": [
    {
      "id": "weather-library-selection",
      "class": "weather-library-group",
      "title": "Weather Library Selection",
      "order": 1,
      "fields": [
        {
          "id": "weather-library-control",
          "label": "Weather Library",
          "path": "/HouseFile/ProgramInformation/Weather/@library",
          "control": "custom",
          "renderer": "weather-library-control",
          "order": 1,
          "layout": { "colSpan": 12 }
        }
      ]
    },
    {
      "id": "regional-location",
      "class": "weather-regional-group",
      "title": "Regional Location",
      "order": 2,
      "fields": [
        {
          "id": "region",
          "label": "Region",
          "path": "/HouseFile/ProgramInformation/Weather/Region",
          "control": "coded-select",
          "optionsRef": "weather-regions",
          "order": 1,
          "layout": { "colSpan": 12, "rowClass": "weather-regional-row" },
          "bind": { "dictFor": "weather-regions" }
        },
        {
          "id": "location",
          "label": "Location",
          "path": "/HouseFile/ProgramInformation/Weather/Location",
          "control": "custom",
          "renderer": "weather-location-search",
          "order": 2,
          "layout": { "colSpan": 12, "rowClass": "weather-regional-row" },
          "dependsOn": [
            {
              "field": "region",
              "path": "/HouseFile/ProgramInformation/Weather/Region/@code",
              "optionsRef": "weather-locations",
              "optionsKey": "recordsByRegion"
            }
          ]
        }
      ]
    },
    {
      "id": "site-specific-data",
      "class": "weather-site-group",
      "title": "Site Specific Data",
      "order": 3,
      "fields": [
        {
          "id": "frostline",
          "label": "Depth of frostline",
          "path": "/HouseFile/ProgramInformation/Weather/@depthOfFrost",
          "control": "number",
          "measure": "length",
          "order": 1,
          "layout": { "colSpan": 12, "rowClass": "weather-site-row" }
        },
        {
          "id": "hdd",
          "label": "Heating Degree Days from Weather File :",
          "path": "/HouseFile/ProgramInformation/Weather/@heatingDegreeDay",
          "control": "number",
          "order": 2,
          "layout": { "colSpan": 12, "rowClass": "weather-site-row" },
          "disabled": true
        }
      ]
    }
  ],
  "behaviors": [
    {
      "id": "region-change-reset-location",
      "trigger": { "path": "/HouseFile/ProgramInformation/Weather/Region/@code" },
      "action": "ensureWeatherLocationForRegion"
    },
    {
      "id": "location-change-apply-hdd",
      "trigger": { "path": "/HouseFile/ProgramInformation/Weather/Location/@code" },
      "action": "applyWeatherClimate"
    }
  ]
}
